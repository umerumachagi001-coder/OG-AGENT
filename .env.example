# Copy to .env and fill in. Everything is optional; without a key the rule playbook diagnoses.
ANTHROPIC_API_KEY=

# auto = Claude if a key is set, otherwise rule-based playbooks | llm | rules
OEA_AGENT_MODE=auto
OEA_MODEL=claude-sonnet-5-5
OEA_MAX_TOOL_CALLS=8
OEA_LLM_TIMEOUT=25

OEA_SERVICES_URL=http://127.0.0.1:8000
# OEA_DB=data/oea.db
# OEA_POLICY=agent/policy.json

# n8n runs the process (default from scripts/dev.py); python = built-in engine, no Node needed
OEA_ENGINE=n8n
OEA_N8N_URL=http://127.0.0.1:5678
# Slack incoming-webhook URL for "needs a decision" pings (optional)
OEA_SLACK_WEBHOOK_URL=
OEA_DASHBOARD_URL=http://localhost:8001

# ── Supabase (optional; see supabase/README.md). Leave the keys empty to run without it. ──
# Project URL: Supabase dashboard → Project Settings → Data API
SUPABASE_URL=https://hfbizcbpuqhlegluaxxb.supabase.co
# Publishable key (sb_publishable_...): turns on dashboard sign-in. Safe for browsers by design.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): copies case records to Supabase. BACKEND ONLY: never commit it, never put it in
# frontend code. .env is in .gitignore.
SUPABASE_SECRET_KEY=
# 0 = keep the dashboard open even when the publishable key is set (e.g. for scripts/e2e tests)
OEA_REQUIRE_LOGIN=1
OEA_SUPABASE_SYNC_SECONDS=3

# ── Voice assistant. Works without any key: the browser's own voice (Chrome/Edge, English). ──
# Optional upgrade: Sarvam AI (English + Hindi). Backend only, like the Supabase secret key.
# Get it from https://dashboard.sarvam.ai and test it with: python scripts/check_sarvam.py
SARVAM_API_KEY=
# browser = always use the browser's voice, even with a Sarvam key set
# OEA_VOICE_ENGINE=browser
# OEA_SARVAM_TTS_MODEL=bulbul:v4-flash
# OEA_SARVAM_SPEAKER=
