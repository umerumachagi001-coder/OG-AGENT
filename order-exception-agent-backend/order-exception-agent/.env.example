# Copy to .env and fill in. Only the API key is required for LLM mode (NFR-4).
ANTHROPIC_API_KEY=

# auto = Claude if a key is set, otherwise rule-based playbooks | llm | rules
OEA_AGENT_MODE=auto
OEA_MODEL=claude-sonnet-5-5
OEA_MAX_TOOL_CALLS=8
OEA_LLM_TIMEOUT=25

OEA_SERVICES_URL=http://127.0.0.1:8000
# OEA_DB=data/oea.db
# OEA_POLICY=agent/policy.json
