      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -420
      ],
      "parameters": {
        "content": "## Investigate and resolve one exception\n1. Claim it\n2. Check the systems that matter for this kind of problem\n3. Ask Claude for the root cause and 1–3 ranked fixes (rule playbook if Claude is off or fails)\n4. Apply the approval policy (`agent/policy.json`)\n5. Hold the order if it must not move\n6. Fix it automatically, **or** ping a person and wait for the dashboard's Approve / Reject",
        "width": 560,
        "height": 260,
        "color": 7
      }
    },
