      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        -100
      ],
      "parameters": {
        "jsCode": "// Pull the structured diagnosis out of Claude's reply (forced submit_resolution tool call).\nconst r = $input.first().json;\nconst block = (r.content || []).find((b) => b.type === 'tool_use' && b.name === 'submit_resolution');\nconst thoughts = (r.content || []).filter((b) => b.type === 'text').map((b) => b.text);\nif (!block) {\n  const why = r.error ? (r.error.message || JSON.stringify(r.error)) : 'Claude returned no diagnosis';\n  return [{ json: { ok: false, reason: `Claude unavailable: ${why}`.slice(0, 300) } }];\n}\nreturn [{ json: { ok: true, source: 'llm', resolution: { ...block.input, thoughts } } }];\n"
      }
    },
